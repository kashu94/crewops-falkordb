# Copy to .env and adjust. Every value has a default; nothing here is required for a local run.

# FalkorDB (docker compose up -d falkordb exposes it on 6379)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
# FALKORDB_USERNAME=
# FALKORDB_PASSWORD=

# Graph names. The operation lives in one graph; each user gets their own memory graph.
CREWOPS_OPS_GRAPH=crewops
CREWOPS_MEMORY_PREFIX=crewops_memory_

# The operation's clock. Leave unset to use the seed snapshot (2026-10-12T18:00:00Z),
# which keeps every answer reproducible.
# CREWOPS_NOW=2026-10-13T04:00:00Z

# The assistant agent. Without a key it answers from the deterministic planner only.
# ANTHROPIC_API_KEY=
CREWOPS_MODEL=claude-opus-5-5
